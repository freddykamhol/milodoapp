{
  "name": "milodo-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.20.2 <21"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "predev": "node scripts/build-styles.mjs",
    "dev:server": "node server.js",
    "build": "node --import ./scripts/windows-fs-compat.mjs node_modules/next/dist/bin/next build --webpack",
    "prebuild": "node scripts/build-styles.mjs",
    "preview": "node scripts/preview.mjs",
    "start": "next start -H 0.0.0.0",
    "start:server": "node scripts/start-server.mjs",
    "lint": "eslint",
    "test:blog-editor": "node scripts/test-rich-editor.mjs",
    "test:ui": "node scripts/test-ui-components.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:performance:ui": "node scripts/test-performance-ui.mjs",
    "test:messages": "node scripts/test-message-outbox.mjs",
    "test:uploads": "node scripts/test-message-upload-ui.mjs",
    "test:defect-appointments:ui": "node scripts/test-defect-appointment-ui.mjs",
    "test:companies:ui": "node scripts/test-company-ui.mjs",
    "test:courses:pdf": "node scripts/test-course-pdf.mjs",
    "benchmark:performance": "node scripts/test-system-ui.mjs --production --benchmark-after",
    "test:system": "node scripts/test-system-ui.mjs",
    "test:system:production": "node scripts/test-system-ui.mjs --production",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:text": "tsx scripts/audit-data-text.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:drop": "drizzle-kit drop",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.35",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "@types/sanitize-html": "^2.16.2",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.1.6",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.20.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^3.1.3",
    "sanitize-html": "^2.17.5",
    "ssh2-sftp-client": "^11.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.6",
    "pdfjs-dist": "^5.6.205"
  }
