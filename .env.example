NEXT_PUBLIC_CONTACT_EMAIL="hello@milodo-app.local"
#
# Database
#
# This project uses SQLite via drizzle + better-sqlite3.
# For production, prefer an absolute path (and ensure the directory is writable).
# Examples:
#   DATABASE_URL="file:/var/www/vhosts/milodo-medical.de/data/portal.db"
#   DATABASE_URL="/var/www/vhosts/milodo-medical.de/data/portal.db"
DATABASE_URL="./dev.db"
AUTH_SECRET="dev-secret-change-me"
CONTACT_INQUIRY_TO_EMAIL="info@milodo-medical.de"
# Comma-separated list of origins allowed to POST /api/public/contact-inquiries (CORS)
CONTACT_INQUIRY_ALLOWED_ORIGINS="https://milodo-medical.de,https://www.milodo-medical.de"
# Recaptcha v3 (server-side verification for /api/public/contact-inquiries)
RECAPTCHA_SECRET_KEY=""
# Minimum score to accept (0.0 - 1.0). Default: 0.3
RECAPTCHA_MIN_SCORE="0.3"
# 32-byte key base64 for encrypting stored integration secrets (SMTP/SFTP/etc.) at rest.
# Example (macOS): `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=""
#
# Demo mode
#
# When enabled, unauthenticated requests fall back to DEMO_USER_ID as the viewer.
# Also run `npm run db:seed` (or `npm run db:bootstrap`) once to create the demo user.
ALLOW_DEMO_AUTH="0"
DEMO_USER_ID="1"
DEMO_USER_USERNAME="demo"
DEMO_USER_PASSWORD="demo123"
DEMO_USER_ROLE="ADMIN"
DEMO_CUSTOMER_ID="260001"
DEMO_CUSTOMER_NAME="Demo Kunde"
DEMO_USER_QUAL_RD="NFS"
DEMO_USER_QUAL_AUSB=""
DEMO_SEED_APPOINTMENTS="1"

#
# App URL (used for links in some emails; default is app.milodo-medical.de)
#
# APP_URL="https://portal.milodo-medical.de"
